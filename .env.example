# Copy this file to .env and fill in the values.
# Never commit .env.

PORT=3001

# Dedicated host (admin.goelprep.com or localhost:3001). Keep this as /.
# Only use /admin/ if you ever mount this app under another site's /admin path.
BASE_PATH=/

# Used by Vite's /api proxy in `npm run dev` and `vite preview`.
# Nginx in production also proxies /api/ to the API, so this is a fallback.
# Local:
INTERNAL_PROXY_BASE_URL=http://localhost:8080
# Live API:
# INTERNAL_PROXY_BASE_URL=https://api.goelprep.com
